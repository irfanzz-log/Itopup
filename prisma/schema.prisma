generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String     @id @default(uuid())
  name           String
  email          String     @unique
  emailVerified  Boolean    @default(false)
  phone          String?
  // Nullable on purpose: an account created via Google OAuth has no password
  // until the user sets one on the set-password page. NULL is the "no
  // password" marker; a sentinel string here would be accepted by
  // `verifyPassword` and read as a real hash elsewhere.
  passwordHash   String?
  role           Role       @default(MEMBER)
  status         UserStatus @default(ACTIVE)
  blockedReason  String?
  blockedAt      DateTime?
  sessionVersion Int        @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  auditLogs      AuditLog[]      @relation("AuditActor")
  orders         Order[]
  createdPromos  Promo[]
  voucherClaims  VoucherClaim[]
  sessions       Session[]
  gameCredentials GameCredential[]
  oauthAccounts  OAuthAccount[]

  @@index([email])
  @@index([role, status])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id          String   @id @default(uuid())
  tokenHash   String   @unique
  userId      String
  userVersion Int      @default(0)
  ip          String?
  userAgent   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Category {
  id          String       @id @default(uuid())
  kind        CategoryKind @unique
  name        String
  slug        String       @unique
  description String?
  icon        String?
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  games        Game[]
  promos       Promo[]   @relation("CategoryToPromo")

  @@index([isActive, sortOrder])
  @@map("categories")
}

/// A purchasable "brand" inside a category: Mobile Legends, DANA, Telkomsel.
/// `inputFields` is the config-driven contract for what the checkout must
/// collect (userId+zoneId, phone number, ...). It is a JSON array of
/// { key, label, placeholder, pattern, minLength, maxLength, required,
/// validateWithProvider } — see src/config/input-fields.js for the shape.
/// Keeping it on the row (not in code) is what lets a new game be added from
/// the admin panel without a deploy.
model Game {
  id                 String    @id @default(uuid())
  categoryId         String
  name               String
  slug               String    @unique
  publisher          String?
  description        String?
  logo               String?
  banner             String?
  /// JSON array — see doc comment above.
  inputFields        Json      @default("[]")
  /// Whether the provider adapter exposes account validation for this game.
  supportsValidation Boolean   @default(false)
  /// Whether CHECKOUT must collect the customer's own game login (identifier +
  /// secret) for this game, because the provider's flow demands it.
  ///
  /// SECURITY: `true` moves this game's checkout from "what the customer knows
  /// about an account" (a User ID) to "what the customer IS on that account"
  /// (a password). It switches on the credential path: an extra input section,
  /// an encrypted store, and a mapper that refuses to send a secret in a field
  /// the provider did not ask for. Games without it never see a password field
  /// and their checkout is unchanged.
  needsGameLogin   Boolean   @default(false)
  isPopular          Boolean   @default(false)
  isActive           Boolean   @default(true)
  sortOrder          Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  category      Category  @relation(fields: [categoryId], references: [id])
  products      Product[]
  promos        Promo[]   @relation("GameToPromo")
  gameCredentials GameCredential[]

  @@index([categoryId, isActive, sortOrder])
  @@index([slug])
  @@index([isActive, isPopular])
  @@map("games")
}

/// A *type* of top-up product within a game, e.g. "Diamonds", "Weekly Pass",
/// "Pulsa Reguler", "DANA". Nominal cards are its ProductVariants.
model Product {
  id          String           @id @default(uuid())
  gameId      String
  name        String
  slug        String
  description String?
  icon        String?
  /// How variants are ordered/displayed: NOMINAL (by value) or MANUAL.
  sortMode    SortMode         @default(NOMINAL)
  isActive    Boolean          @default(true)
  sortOrder   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  variants    ProductVariant[]
  game        Game             @relation(fields: [gameId], references: [id])
  promos      Promo[]          @relation("ProductToPromo")
  @@unique([gameId, slug])
  @@index([gameId, isActive, sortOrder])
  @@map("products")
}

/// The actual card the user clicks: "86 Diamonds", "Rp 10.000".
/// Prices live here and are the ONLY source of truth for what a customer pays.
model ProductVariant {
  id               String            @id @default(uuid())
  productId        String
  name             String
  slug             String
  /// Numeric denomination (diamonds, rupiah) for sorting/labelling. Null for
  /// non-numeric items such as a weekly pass.
  denomination     Int?
  unit             String?
  /// Harga modal — what the provider charges us. Admin-only, never serialised
  /// to a public response.
  costPrice        Int
  /// Base selling price before promo. What the customer pays by default.
  sellingPrice     Int
  /// Optional admin override; null means "derive from costPrice + markup".
  isActive         Boolean           @default(true)
  /// Provider-reported stock; null means unlimited / untracked.
  stock            Int?
  sortOrder        Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  orderItems       OrderItem[]
  product          Product             @relation(fields: [productId], references: [id])
  providerProducts ProviderProduct[]
  promos           Promo[]             @relation("ProductVariantToPromo")
  promoTarget      Promo?              @relation("VariantToPromoTarget")

  @@unique([productId, slug])
  @@index([productId, isActive, sortOrder])
  @@index([isActive])
  @@map("product_variants")
}

model Provider {
  id               String            @id @default(uuid())
  /// Adapter key resolved by src/providers/index.js — e.g. "melostore".
  code             String            @unique
  kind             ProviderKind      @default(TOPUP)
  name             String
  status           ProviderStatus    @default(ACTIVE)
  /// Non-secret base URL, kept here so ops can point at a sandbox without a
  /// redeploy. Credentials themselves live ONLY in environment variables.
  baseUrl          String?
  priority         Int               @default(0)
  lastSyncAt       DateTime?
  lastSyncStatus   String?
  /// Cached provider balance in rupiah. Written by the balance sync service.
  balance          Int?
  balanceUpdatedAt DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  /// Reference data from the last successful catalogue sync: the provider's
  /// brand list and inquiry-form definitions. Stored so /dev/providers can show
  /// whether the fields we render still match what the provider expects.
  catalogMeta      Json?
  orders           Order[]
  providerProducts ProviderProduct[]

  @@index([kind, status, priority])
  @@map("providers")
}

/// Maps one internal ProductVariant to one provider SKU.
/// This table is the ONLY place a provider product code appears.
model ProviderProduct {
  id               String         @id @default(uuid())
  providerId       String
  productVariantId String
  /// The provider's own product/SKU code. Provider-specific by definition.
  providerCode     String
  /// Provider's own display name for the SKU (for admin comparison).
  providerName     String?
  /// Last price quoted by the provider. Drives costPrice during sync.
  providerPrice    Int?
  providerStock    Int?
  isAvailable      Boolean        @default(true)
  /// Raw last payload from the provider, for debugging sync drift.
  lastSyncPayload  Json?
  lastSyncAt       DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  provider         Provider       @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, providerCode])
  @@unique([providerId, productVariantId])
  @@index([productVariantId])
  @@index([isAvailable])
  @@map("provider_products")
}

model Order {
  id               String           @id @default(uuid())
  /// Customer-facing invoice, e.g. ITP-20260925-7F3K2Q9A.
  invoice          String           @unique
  userId           String
  status           OrderStatus      @default(PENDING_PAYMENT)
  gameName         String
  productName      String
  variantName      String
  quantity         Int              @default(1)
  /// What the customer typed (player id, zone id, phone, ...). A JSON object
  /// keyed by the Game.inputFields contract. Provider params are derived from
  /// this by the adapter's mapper — never by the order service.
  customerInput    Json
  unitCostPrice    Int
  unitSellingPrice Int
  subtotal         Int
  discount         Int              @default(0)
  fee              Int              @default(0)
  total            Int
  /// total - (unitCostPrice * quantity) — reporting only, never trusted for
  /// anything financial.
  margin           Int              @default(0)
  providerId       String?
  providerRef      String?
  /// The provider's own order id, when it differs from providerRef.
  providerOrderId  String?
  providerStatus   String?
  providerMessage  String?
  /// Incremented every time we dispatch to the provider. Guards against a
  /// retry storm and makes reconciliation auditable.
  providerAttempts Int              @default(0)
  dispatchedAt     DateTime?
  completedAt      DateTime?
  /// Client-supplied key from the checkout form. Unique per user: a double
  /// click, a refresh, or a retried request resolves to the same order.
  idempotencyKey   String
  /// Hash of the checkout payload. If the same key arrives with a different
  /// payload we reject it (409) instead of silently returning the old order.
  requestHash      String
  expiresAt        DateTime?
  /// The stored game login this order was placed against, when the game's
  /// provider flow required the customer's own credentials (see
  /// Game.needsGameLogin). Written ONCE at checkout; never updated. It is a
  /// reference, not a credential: the ciphertext stays in GameCredential, and
  /// this column is what lets dispatch reload the secret without storing it on
  /// the order row itself.
  credentialId     String?
  ip               String?
  userAgent        String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  items            OrderItem[]
  provider         Provider?       @relation(fields: [providerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user             User             @relation(fields: [userId], references: [id])
  payment          Payment?
  logs             TransactionLog[]
  /// The stored game login this order was placed against. The relation is what
  /// lets dispatch reload the ciphertext. It is deliberately NOT cascading
  /// (ON DELETE NO ACTION in the migration): deleting a stored login is refused
  /// while an order still references it, so history is never silently rewritten.
  credential       GameCredential?  @relation(fields: [credentialId], references: [id])

  @@unique([userId, idempotencyKey])
  @@unique([providerId, providerRef])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@index([invoice])
  @@index([createdAt])
  @@map("orders")
}

/// One line per order today, but modelled as a list so a future "buy 2 items in
/// one checkout" does not require a schema migration.
model OrderItem {
  id               String         @id @default(uuid())
  orderId          String
  productVariantId String
  gameName         String
  productName      String
  variantName      String
  quantity         Int            @default(1)
  unitCostPrice    Int
  unitSellingPrice Int
  subtotal         Int
  createdAt        DateTime       @default(now())
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([orderId])
  @@index([productVariantId])
  @@map("order_items")
}

model Payment {
  id           String        @id @default(uuid())
  /// One payment per order — the unique constraint is what makes a webhook
  /// replay harmless.
  orderId      String        @unique
  providerCode String
  status       PaymentStatus @default(PENDING)
  method       String?
  /// Gateway-side reference (VA number, QR id, invoice id).
  reference    String?
  externalId   String?
  amount       Int
  fee          Int           @default(0)
  paidAmount   Int?
  /// Payment instructions / VA number handed to the customer.
  instructions Json?
  expiresAt    DateTime?
  paidAt       DateTime?
  rawPayload   Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([providerCode, reference])
  @@index([status, expiresAt])
  @@index([createdAt])
  @@map("payments")
}

/// Append-only event trail. Nothing in the app ever updates or deletes a row
/// here; it is the forensic record of what actually happened to an order.
model TransactionLog {
  id         String   @id @default(uuid())
  orderId    String?
  /// Correlates every log line of one request / provider call.
  requestId  String?
  /// Machine-readable event name: ORDER_CREATED, PAYMENT_WEBHOOK_RECEIVED, ...
  event      String
  /// Optional internal error code (ITP_PROVIDER_TIMEOUT, ...).
  code       String?
  message    String?
  /// Structured context. NEVER store secrets, tokens or full payment data here.
  metadata   Json?
  durationMs Int?
  createdAt  DateTime @default(now())
  order      Order?   @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
  @@index([event, createdAt])
  @@index([requestId])
  @@map("transaction_logs")
}

model Promo {
  id            String           @id @default(uuid())
  title         String
  slug          String           @unique
  description   String?
  /// Sanitised HTML is NOT accepted here in Phase 1 — the field is plain text
  /// and rendered escaped. If rich content is needed later, sanitise on write
  /// AND render through a sanitising component.
  image         String?
  banner        String?
  discountType  DiscountType
  discountValue Int
  /// Cap for PERCENT discounts, in rupiah.
  maxDiscount   Int?
  minSpend      Int              @default(0)
  startsAt      DateTime
  endsAt        DateTime
  isActive      Boolean          @default(true)

  /// ── Scope ──────────────────────────────────────────────────────────────
  /// Resolves `categoryId` / `gameId` / `productId` / `variantId`.
  /// ALL means "no target, applies to the whole catalogue".
  scope         PromoScope       @default(ALL)
  categoryId    String?
  gameId        String?
  productId     String?
  /// @unique because scope=VARIANT targets exactly one nominal (1:1).
  variantId     String?          @unique

  /// ── Distribution ───────────────────────────────────────────────────────
  /// AUTO: applied at checkout without any code, automatically, on every
  ///   eligible purchase. This is the "diskon manual" the admin sets per
  ///   category/game/product/variant.
  /// VOUCHER: the customer must claim it (or type its code) at checkout.
  distribution  PromoDistribution @default(VOUCHER)

  /// ── Voucher audience & quota ───────────────────────────────────────────
  /// Who may CLAIM a voucher. Ignored for AUTO promos.
  audience      VoucherAudience  @default(ALL_USERS)
  /// For LOYAL_CUSTOMER: minimum completed orders. Zero otherwise.
  minCompletedOrders Int          @default(0)
  /// Total claims allowed. null = unlimited. Enforced atomically at claim,
  /// never by read-then-write.
  claimLimit    Int?
  /// Cache of VoucherClaim rows with status ACTIVE/REDEEMED. Kept in sync by
  /// the claim path; a denormalised count lets the UI show "3/10 tersisa"
  /// without counting on every render.
  claimCount    Int              @default(0)

  /// ── Visibility ─────────────────────────────────────────────────────────
  /// Only meaningful for VOUCHER promos (AUTO promos are never listed
  /// publicly anyway — they apply by themselves). PUBLIC vouchers show on
  /// /promo and on the claimable shelf; HIDDEN ones are usable only by typing
  /// their code. Default PUBLIC so a voucher created before this column
  /// existed keeps appearing exactly where it already appeared.
  visibility    PromoVisibility  @default(PUBLIC)

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  createdById   String?
  codes         PromoCode[]
  createdBy     User?            @relation(fields: [createdById], references: [id])
  /// Legacy M2M kept for the original promo-to-variant scoping. New promos use
  /// `scope` + `variantId` instead; this field is retained so existing rows
  /// still resolve and no migration loses data.
  variants      ProductVariant[] @relation("ProductVariantToPromo")
  category      Category?        @relation("CategoryToPromo", fields: [categoryId], references: [id])
  game          Game?            @relation("GameToPromo", fields: [gameId], references: [id])
  product       Product?         @relation("ProductToPromo", fields: [productId], references: [id])
  /// The single variant this promo targets when scope = VARIANT. Distinct from
  /// the `variants` M2M above — one is the new target column, the other the
  /// legacy relation.
  variant       ProductVariant?  @relation("VariantToPromoTarget", fields: [variantId], references: [id])
  claims        VoucherClaim[]

  @@index([isActive, startsAt, endsAt])
  @@index([slug])
  @@index([scope, isActive])
  @@index([distribution, isActive])
  @@index([visibility, isActive])
  @@index([categoryId, isActive])
  @@index([gameId, isActive])
  @@index([productId, isActive])
  @@index([variantId, isActive])
  @@map("promos")
}

model PromoCode {
  id           String   @id @default(uuid())
  promoId      String
  /// Stored upper-cased; lookups upper-case the input before querying.
  code         String   @unique
  /// null = unlimited. Enforced atomically at checkout, not by a read-then-write.
  usageLimit   Int?
  usageCount   Int      @default(0)
  perUserLimit Int?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  promo        Promo    @relation(fields: [promoId], references: [id], onDelete: Cascade)

  @@index([promoId, isActive])
  @@map("promo_codes")
}

/// One user's ownership of one claimable voucher.
///
/// A row here IS the customer's voucher: "Voucher Saya" is the ACTIVE rows,
/// checkout spends one by id, and the atomic `claimLimit` guard is what stops
/// the 11th user from claiming a 10-user voucher.
model VoucherClaim {
  id        String      @id @default(uuid())
  userId    String
  promoId   String
  status    ClaimStatus @default(ACTIVE)
  claimedAt DateTime    @default(now())
  /// Order invoice that consumed this claim. Set at redemption, kept forever.
  redeemedAt  DateTime?
  redeemedInvoice String?
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  promo     Promo  @relation(fields: [promoId], references: [id], onDelete: Cascade)

  /// Exactly ONE row per user per promo. The status column deliberately stays
  /// OUT of this constraint: it is state, not identity. With status in the key
  /// (@@unique([userId, promoId, status]) — the original schema), redeeming a
  /// claim flips it ACTIVE→REDEEMED and the user is then locked out of that
  /// promo forever, because any later claim re-redeemed collides with the
  /// existing REDEEMED row on the same triple. A customer who re-claims a promo
  /// they already used once and then checks out gets `redeemVoucherClaim`'s
  /// updateMany P2002 → POST /api/orders 500 (requestId
  /// f9405f6a-638f-4ebc-b268-715ec70df2ea, 2026-09-29).
  @@unique([userId, promoId])
  @@index([userId, status])
  @@index([promoId, status])
  @@map("voucher_claims")
}

/// Admin action trail. Written by the audit service, never by user code paths.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actorRole  Role?
  /// ACTION_NAME in SCREAMING_SNAKE, e.g. MEMBER_BLOCKED.
  action     String
  /// Model name + id of the affected row, e.g. ("User", "<uuid>").
  targetType String?
  targetId   String?
  /// Before/after diff, limited to non-sensitive fields. Never a password hash,
  /// never a token, never an API key.
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

/// Denormalised block record so "why was this member blocked, by whom, when"
/// survives even if the user row is later modified.
model UserBlock {
  id            String    @id @default(uuid())
  userId        String
  reason        String
  blockedById   String?
  blockedAt     DateTime  @default(now())
  unblockedAt   DateTime?
  unblockedById String?

  @@index([userId, unblockedAt])
  @@map("user_blocks")
}

/// Webhook replay protection. Every provider/payment callback inserts its
/// unique external event id here first; a duplicate insert (P2002) means the
/// callback is a replay and must be acknowledged without re-processing.
model WebhookEvent {
  id           String   @id @default(uuid())
  providerCode String
  /// Provider's own event/message id, or a hash of the signed body when the
  /// provider does not send one.
  externalId   String
  eventType    String?
  orderId      String?
  payloadHash  String
  processedAt  DateTime @default(now())

  @@unique([providerCode, externalId])
  @@index([orderId])
  @@map("webhook_events")
}

/// Generic key-value store for provider sync cursors and other ops state that
/// does not deserve its own table.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

/// Email OTP codes for registration and recovery.
///
/// One live row per (subject, purpose). A new code for the same subject and
/// purpose replaces the old one rather than coexisting, so there is never more
/// than one valid code a user can be presented with at a time; this is what
/// makes "wrong code" unambiguous and keeps the table from accumulating
/// guessable rows.
model EmailOtp {
  id        String   @id @default(uuid())
  subject   String
  purpose   EmailOtpPurpose
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  consumedAt DateTime?
  ip        String?
  // For REGISTER: the form the user submitted (name, passwordHash, phone), so
  // the account is only created once the code is confirmed. Stored on the row
  // instead of a second table or a client-side round-trip, because the code is
  // already the single secret gating this data.
  payload   Json?
  createdAt DateTime @default(now())

  @@unique([subject, purpose])
  @@index([expiresAt])
  @@map("email_otps")
}

/// A Google account linked to a local user (OAuth login).
///
/// One row per provider + subject (`sub` claim), not per user: if a Google
/// account is unlinked and another local user links it later, the second link
/// must be a new row, and the old one must not be reusable to sign in as the
/// first user. `email` is stored to detect a Google sign-in for an email that
/// already belongs to a password account, so the account can be linked rather
/// than duplicated.
model OAuthAccount {
  id            String   @id @default(uuid())
  userId        String
  provider      String   @default("google")
  subject       String
  email         String
  linkedAt      DateTime @default(now())
  lastLoginAt   DateTime?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@unique([provider, email])
  @@index([userId])
  @@map("oauth_accounts")
}

enum Role {
  MEMBER
  DEV
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum EmailOtpPurpose {
  REGISTER
}

enum CategoryKind {
  GAME
  E_WALLET
  PULSA
}

enum SortMode {
  NOMINAL
  MANUAL
}

enum ProviderKind {
  TOPUP
  PAYMENT
}

enum ProviderStatus {
  ACTIVE
  DEGRADED
  DISABLED
}

/// ENCRYPTED game-account credentials for a user, for games whose provider flow
/// requires a login the customer owns (eFootball on Melostore asks for the
/// player's own game Login + Password — see Game.needsGameLogin).
///
/// SECURITY CONTRACT — read before touching this model:
///
///   * `secretCipher` and `secretIv` are AES-256-GCM ciphertext + IV. The
///     plaintext is held ONLY in memory, for the single provider call that
///     needs it. Nothing in the app ever writes a plaintext credential to the
///     database, a log, a TransactionLog.metadata, or an API response.
///   * The key is `GAME_CREDENTIAL_KEY`, derived from AUTH_SECRET (never a
///     second secret to leak independently), and rotated by re-encrypting.
///   * `lastUsedAt` is the only usage signal kept. A credential may be deleted
///     by its owner at any time; deletion is a real row removal, never a flag.
///   * `attempts`/`failures` are deliberately NOT recorded here: tracking them
///     would make this table an oracle for which logins are valid.
model GameCredential {
  id           String   @id @default(uuid())
  userId       String
  /// The game this login belongs to. Credentials are per-game, never shared.
  gameId       String
  /// The login identifier the customer typed (e.g. an email or Konami ID).
  /// Stored in plaintext: it is the equivalent of a User ID — it identifies the
  /// account without granting access to it — and showing it back is how the
  /// customer recognises which stored login this is.
  login        String
  /// AES-256-GCM ciphertext of the password/secret, base64.
  secretCipher String
  /// 12-byte GCM IV, base64. Unique per row: GCM with a reused IV under one key
  /// is catastrophic, so the IV is generated per encryption, never derived.
  secretIv     String
  lastUsedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game         Game     @relation(fields: [gameId], references: [id])
  /// Orders placed against this login. Non-cascading by design (see Order).
  orders       Order[]

  /// One stored login per (user, game, login). A customer may keep several
  /// logins for the same game (a smurf account), but the same login twice would
  /// be the same secret stored twice.
  @@unique([userId, gameId, login])
  @@index([userId, gameId])
  @@map("game_credentials")
}

/// Explicit state machine — never a boolean. Transitions are enforced in
/// src/services/order.service.js; anything not listed there is rejected.
enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  PROCESSING
  SUCCESS
  FAILED
  REFUND
  EXPIRED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  EXPIRED
  REFUNDED
  CANCELLED
}

enum DiscountType {
  FIXED
  PERCENT
}

/// How a promo reaches the customer.
enum PromoDistribution {
  /// Applied automatically at checkout to every eligible purchase — the
  /// "diskon manual" the admin sets without issuing any code.
  AUTO
  /// Must be claimed by the customer (or its code typed) at checkout.
  VOUCHER
}

/// Where a voucher may be SEEN. This is a publishing control, not a security
/// one: it decides only whether the promo appears on /promo and on the
/// claimable-voucher shelf. A HIDDEN voucher is still fully usable — its code
/// can be typed at checkout and every other rule still applies. Security is
/// never a function of this column: the checkout validates the code server-side
/// regardless of visibility, so "hidden" cannot be bypassed by tampering with a
/// request, and knowing a public voucher's row is not an advantage either.
enum PromoVisibility {
  /// Shown on /promo and claimable from "Voucher Saya".
  PUBLIC
  /// Not listed anywhere the customer can browse. Usable only by typing its code
  /// at checkout — the operator distributes the code out-of-band.
  HIDDEN
}

/// What a promo applies to. A promo with scope ALL needs no target rows;
/// CATEGORY / GAME / VARIANT resolve the targets through the *_id columns.
enum PromoScope {
  /// Every product in the catalogue.
  ALL
  /// Everything in one Category (all games, or all pulsa).
  CATEGORY
  /// One Game, e.g. Mobile Legends (all of its products).
  GAME
  /// One Product, e.g. by.U pulsa (all of its nominals).
  PRODUCT
  /// One exact nominal: 570 Diamonds, or Pulsa Telkomsel 10.000.
  VARIANT
}

/// Which users are allowed to claim a voucher. Determines the eligibility
/// check at claim time and the label the customer sees.
enum VoucherAudience {
  /// Everybody — no conditions beyond the claim quota and the active window.
  ALL_USERS
  /// Never completed a SUCCESS order. Counted at claim time, not at sign-up.
  NEW_CUSTOMER
  /// Has at least `minCompletedOrders` completed orders.
  LOYAL_CUSTOMER
}

/// State of one user's claim on a voucher. A row here IS ownership: the
/// customer's "Voucher Saya" list is these rows, and checkout reads one by id.
enum ClaimStatus {
  /// Claimed, not used yet.
  ACTIVE
  /// Consumed by an order. Kept (not deleted) so the history stays queryable
  /// and a refund can tell whether the voucher should be returned.
  REDEEMED
  /// Admin revoked it, or the voucher's audience/quota changed. Never spendable.
  VOIDED
}

# ============================================================================
# ITOPUP — environment template. Copy to `.env` and fill in real values.
# NEVER commit `.env`. NEVER paste provider/payment secrets into client code —
# only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ============================================================================

# ── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# DATABASE_URL: pooled connection (Supabase "Transaction pooler", port 6543).
#   Used by the running app through the Prisma driver adapter.
# DIRECT_URL:   direct connection (port 5432). Used for migrations/introspection.
DATABASE_URL=
DIRECT_URL=

# ── Application ─────────────────────────────────────────────────────────────
# The absolute canonical origin. metadataBase, sitemap.xml, robots.txt, and
# every JSON-LD node read this (src/lib/site-url.js), so they can never
# disagree about the domain. MUST be set to the real https URL in production:
# leave it out and the sitemap is full of localhost URLs Google will ignore.
NEXT_PUBLIC_APP_URL="http://localhost:3200"
NODE_ENV="development"

# ── Pricing ───────────────────────────────────────────────────────────────
# Margin on top of the provider cost. Game products take a percentage
# (1.04 = 4%). Airtime (PULSA) ignores the percentage and takes a FIXED spread
# in rupiah instead, because airtime is sold at a near-zero spread and a
# percentage big enough to matter would price a Rp 100.000 card above its face
# value. Both are read in src/config/pricing.js.
#
# PRICING_ROUND_TO is the rounding step for the derived price. 1 means NO
# rounding: the price is exactly cost × multiplier. A step of 100 makes prices
# look tidier but HIDES small markup changes — 1.03 vs 1.02 on a Rp 1.648 cost
# is a Rp 16 difference, which rounds to the same Rp 1.700.
PRICING_MARKUP_MULTIPLIER="1.04"
PRICING_PULSA_FLAT="1000"
PRICING_ROUND_TO="1"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be >= 32 characters. Rotating it invalidates every active session.
AUTH_SECRET=
SESSION_MAX_AGE=604800

# ── Top-up provider: Melostore H2H ──────────────────────────────────────────
# Which adapter the core app resolves. Core code must never import an adapter
# directly — it goes through src/providers/index.js.
TOPUP_PROVIDER=melostore

# Base URL. The docs' examples use https://api.melostore.id
MELOSTORE_BASE_URL=

# Outbound auth — the documented scheme is TWO headers on every request:
#   X-API-Key:    MELOSTORE_API_KEY
#   X-Secret-Key: MELOSTORE_SECRET
# Both are created in the Melostore partner dashboard.
MELOSTORE_API_KEY=
MELOSTORE_SECRET=

# Inbound webhook verification — SEPARATE from the credentials above.
# The docs: "Tanda tangan diperoleh dari hash HMAC SHA256 dari payload JSON
# mentah menggunakan webhook_secret akun Anda", sent as X-H2H-Signature.
# Without this, every callback is refused and orders only settle via
# reconciliation polling.
MELOSTORE_WEBHOOK_SECRET=

# Optional. Leave EMPTY in production: an empty value means "use whatever the
# account is set to in the Melostore dashboard". Setting it to true sends every
# transaction as a simulation.
MELOSTORE_SANDBOX=

# NOTE: MELOSTORE_USERNAME is intentionally NOT used. The documented auth scheme
# has exactly two credentials and no username field. The variable is listed
# nowhere else on purpose — inventing a third auth factor would be worse than
# leaving an unused variable out.

MELOSTORE_TIMEOUT_MS=15000
MELOSTORE_MAX_ATTEMPTS=2

# ── Payment gateway: Midtrans ─────────────────────────────────────────────
# The ONLY payment provider the registry knows (src/providers/payment/index.js)
# is Midtrans Core API (/v2/charge): we POST the order with a payment_type and
# Midtrans returns the VA number / QR string / payment code to render on our own
# order page. Settlement happens ONLY through the signature-verified webhook at
# POST /api/webhooks/payment/midtrans.
#
# The adapter is driven by MIDTRANS_SERVER_KEY; the generic PAYMENT_* variables
# below are legacy and no adapter reads them. The .env files ship unset keys as
# the placeholder "GANTI-SERVER-KEY" on purpose — the adapter treats any key
# still carrying that marker as UNSET, so an unfilled gateway is reported as a
# configuration gap instead of being offered at checkout and then 401ing.
PAYMENT_PROVIDER=midtrans
MIDTRANS_MERCHANT_ID="GANTI-MERCHANT-ID"
MIDTRANS_SERVER_KEY="GANTI-SERVER-KEY"
MIDTRANS_CLIENT_KEY="GANTI-CLIENT-KEY"
# Empty = sandbox (https://api.sandbox.midtrans.com). Set to "true" for the
# live gateway (https://api.midtrans.com) with real production keys.
MIDTRANS_IS_PRODUCTION=
# JSON array of Midtrans payment types; null/empty = let Midtrans show
# everything enabled in the merchant dashboard. The methods enabled in
# src/config/payment.js map to exactly these:
MIDTRANS_ENABLED_PAYMENTS='["qris","bank_transfer","echannel"]'

# ── Offline transfer — RETIRED ───────────────────────────────────────────────
# The manual/offline payment path has been retired: every customer-facing
# payment method is now served by Midtrans, and the ONLY thing that settles an
# order is the signature-verified Midtrans webhook. The manual adapter remains
# on disk at src/providers/payment/manual/ solely so historical orders
# referencing its method keys still render; no checkout method maps to it.
#
# These variables are therefore kept empty. Do not fill them in.
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=
MANUAL_BANK_ACCOUNTS=
MANUAL_EWALLET_NUMBERS=
# How long the customer has to complete the transfer, in minutes.
MANUAL_TRANSFER_WINDOW_MINUTES=180

# ── Rate limiting ───────────────────────────────────────────────────────────
# Empty = in-process limiter (single instance only). Set both to use an
# external store (Upstash-compatible REST) when running more than one instance.
RATE_LIMIT_URL=
RATE_LIMIT_TOKEN=

# ── Rate limit tuning (requests per 60s window) ─────────────────────────────
RL_LOGIN=8
RL_LOGIN_IP=40
RL_REGISTER=5
RL_VALIDATE=20
RL_VALIDATE_IP=120
RL_ORDER=10
RL_WEBHOOK=300
RL_ADMIN=120
RL_OTP=10
RL_DEFAULT=60
# Payment endpoints (confirm/check/cancel). Every call may reach the gateway,
# so this is also the ceiling on how often one account can bill Midtrans.
RL_PAYMENT=20

# ── Internal jobs (cron) ────────────────────────────────────────────────────
# /api/internal/expire and /api/internal/reconcile move orders to terminal
# states and void gateway charges, so they are never public. TWO independent
# credentials are accepted, either one is enough:
#
#   INTERNAL_KEY  an external scheduler sends it as `X-Internal-Key`. It is also
#                 the secret the proxy uses to report scanner probes to
#                 /api/traffic/scan, so it MUST be set in production.
#   CRON_SECRET   Vercel Cron cannot send a custom header; it sends
#                 `Authorization: Bearer <CRON_SECRET>` plus a vercel-cron user
#                 agent, and both are required.
#
# An UNSET value denies every request — an empty variable must never turn these
# into open endpoints. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_KEY=
CRON_SECRET=

# ── Proxy / client address ──────────────────────────────────────────────────
# TRUST_PROXY=false makes the app ignore X-Forwarded-For entirely and key rate
# limits on the account instead of the address. Only set false when the app is
# exposed DIRECTLY (no reverse proxy), because then the header is client-supplied
# and spoofable. Vercel/nginx/Cloudflare all overwrite it, so the default is true.
TRUST_PROXY=true
# Which header carries the client address, when TRUST_PROXY is on.
TRUSTED_IP_HEADER=x-forwarded-for

# ── Database pool ───────────────────────────────────────────────────────────
# Sizing for the pg driver adapter. Keep the pool small when connecting through
# Supabase's transaction pooler (port 6543): the pooler multiplexes, and a large
# per-instance pool exhausts its backend limit under load.
PG_POOL_MAX=10
# Recycle a connection before the pooler's ~30s idle kill.
PG_IDLE_TIMEOUT_MS=20000
# Fail fast into a clean 503 instead of a stalled request.
PG_CONNECT_TIMEOUT_MS=10000

# ── Pricing ─────────────────────────────────────────────────────────────────
# Used to derive sellingPrice from costPrice during the catalogue sync/seed.
PRICING_MARKUP_MULTIPLIER=1.15
PRICING_MARKUP_FLAT=0
PRICING_PULSA_FLAT=1500
PRICING_ROUND_TO=1
# A variant whose margin falls below this percentage is flagged in /dev/products.
MIN_MARGIN_PERCENT=3

# ── Order lifecycle ─────────────────────────────────────────────────────────
# How long an unpaid order stays payable before the expiry sweep closes it.
ORDER_TTL_MINUTES=60

# ── Auth tuning ─────────────────────────────────────────────────────────────
# bcrypt work factor. 12 is ~250ms on current hardware; lower it only in tests.
BCRYPT_COST=12
# debug | info | warn | error
LOG_LEVEL=info

# ── Provider tuning ─────────────────────────────────────────────────────────
# How long an account-validation answer is reused before the provider is asked
# again. Every miss costs a provider request.
VALIDATION_CACHE_MS=10000
# Delay between pages when walking the provider pricelist (quota protection).
MELOSTORE_PAGE_PACING_MS=300

# ── Email (SMTP) for registration OTP ────────────────────────────────────────
# Nodemailer transport. Registration sends a 6-digit code to verify the email
# address; without these, POST /api/auth/register answers 503
# ITP_OTP_MAIL_UNAVAILABLE instead of pretending to send.
#
# Any SMTP provider works (Zoho, Brevo, Mailtrap, Gmail App Password). Leave
# SMTP_PASS empty only for a truly open relay, which you do not have.
#
# Zoho Mail example:
#   SMTP_HOST=smtppro.zoho.com  SMTP_PORT=587  SMTP_USER=you@yourdomain.com
#   SMTP_PASS=<app-specific password>  SMTP_FROM="ITOPUP <noreply@yourdomain.com>"
#
# Brevo example:
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login email>
#   SMTP_PASS=<SMTP key>  SMTP_FROM="ITOPUP <noreply@yourdomain.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Google OAuth ("Masuk dengan Google") ─────────────────────────────────────
# From the Google Cloud Console: APIs & Services > Credentials > OAuth 2.0
# Client ID (Web application). While these are empty, the "Masuk dengan Google"
# button is hidden on /login and /register, and the start route answers 503.
#
# The Authorized redirect URI must be exactly:
#   <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
#
# NOTE: the button only appears when the client id, secret AND redirect URI are
# all set. A half-configured Google login is worse than none.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ── Statistik: Vercel Web Analytics ──────────────────────────────────────────
# /dev/statistics menampilkan total pengunjung dari Vercel Web Analytics.
# Angka resmi itu hanya bisa dibaca lewat REST API Vercel, dan tokennya HARUS
# tetap di server (bukan NEXT_PUBLIC_*): satu token bisa membaca semua project
# milik akun.
#
# Cara mengisi:
#   1. Aktifkan Web Analytics di dashboard Vercel: project > Analytics > Enable.
#   2. Buat token di https://vercel.com/account/tokens (scope: project terkait).
#   3. VERCEL_PROJECT_ID ada di project > Settings > General > Project ID.
#   4. Jika project di bawah team, isi juga VERCEL_TEAM_ID (Settings > Team).
#
# Tanpa token, halaman tetap berjalan: angka pengunjung jatuh ke perkiraan dari
# IP unik di log aplikasi sendiri, dan halaman menjelaskan bahwa itu perkiraan.
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_TEAM_SLUG=

# Batas kiriman page-view per IP per menit. Beacon mengirim satu event per
# navigasi; nilai ini hanya menahan skrip yang mencoba menggelembungkan angka.
RL_PAGEVIEW=120

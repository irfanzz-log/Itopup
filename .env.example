# ============================================================================
# ITOPUP — environment template. Copy to `.env` and fill in real values.
# NEVER commit `.env`. NEVER paste provider/payment secrets into client code —
# only variables prefixed NEXT_PUBLIC_ are exposed to the browser.
# ============================================================================

# ── Database (Supabase PostgreSQL) ──────────────────────────────────────────
# DATABASE_URL: pooled connection (Supabase "Transaction pooler", port 6543).
#   Used by the running app through the Prisma driver adapter.
# DIRECT_URL:   direct connection (port 5432). Used for migrations/introspection.
DATABASE_URL=
DIRECT_URL=

# ── Application ─────────────────────────────────────────────────────────────
# The absolute canonical origin. metadataBase, sitemap.xml, robots.txt, and
# every JSON-LD node read this (src/lib/site-url.js), so they can never
# disagree about the domain. MUST be set to the real https URL in production:
# leave it out and the sitemap is full of localhost URLs Google will ignore.
NEXT_PUBLIC_APP_URL="http://localhost:3200"
NODE_ENV="development"

# ── Pricing ───────────────────────────────────────────────────────────────
# Margin on top of the provider cost. Game products take a percentage
# (1.04 = 4%). Airtime (PULSA) ignores the percentage and takes a FIXED spread
# in rupiah instead, because airtime is sold at a near-zero spread and a
# percentage big enough to matter would price a Rp 100.000 card above its face
# value. Both are read in src/config/pricing.js.
PRICING_MARKUP_MULTIPLIER="1.04"
PRICING_PULSA_FLAT="1000"
PRICING_ROUND_TO="100"

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Must be >= 32 characters. Rotating it invalidates every active session.
AUTH_SECRET=
SESSION_MAX_AGE=604800

# ── Top-up provider: Melostore H2H ──────────────────────────────────────────
# Which adapter the core app resolves. Core code must never import an adapter
# directly — it goes through src/providers/index.js.
TOPUP_PROVIDER=melostore

# Base URL. The docs' examples use https://api.melostore.id
MELOSTORE_BASE_URL=

# Outbound auth — the documented scheme is TWO headers on every request:
#   X-API-Key:    MELOSTORE_API_KEY
#   X-Secret-Key: MELOSTORE_SECRET
# Both are created in the Melostore partner dashboard.
MELOSTORE_API_KEY=
MELOSTORE_SECRET=

# Inbound webhook verification — SEPARATE from the credentials above.
# The docs: "Tanda tangan diperoleh dari hash HMAC SHA256 dari payload JSON
# mentah menggunakan webhook_secret akun Anda", sent as X-H2H-Signature.
# Without this, every callback is refused and orders only settle via
# reconciliation polling.
MELOSTORE_WEBHOOK_SECRET=

# Optional. Leave EMPTY in production: an empty value means "use whatever the
# account is set to in the Melostore dashboard". Setting it to true sends every
# transaction as a simulation.
MELOSTORE_SANDBOX=

# NOTE: MELOSTORE_USERNAME is intentionally NOT used. The documented auth scheme
# has exactly two credentials and no username field. The variable is listed
# nowhere else on purpose — inventing a third auth factor would be worse than
# leaving an unused variable out.

MELOSTORE_TIMEOUT_MS=15000
MELOSTORE_MAX_ATTEMPTS=2

# ── Payment gateway ─────────────────────────────────────────────────────────
# Left blank on purpose: no payment provider has been selected yet. The
# abstraction lives in src/providers/payment/ and refuses to operate until a
# real provider is configured, rather than faking success.
#
# Enabling a gateway method (VA / QRIS / retail) in src/config/payment.js is not
# enough on its own — its adapter must exist and be configured here, or the
# method stays hidden from checkout.
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

# ── Offline transfer (the adapter that works WITHOUT a gateway) ─────────────
# Customer transfers, an operator verifies against the bank/e-wallet statement
# and confirms in /dev/orders. Bank and e-wallet destinations are configured
# independently: whichever list is empty has its methods hidden from checkout.
#
# Both are JSON arrays. A destination missing name/number/holder is dropped, so
# a half-typed entry can never reach a customer.
#
#   bank:    {"bank":"BCA","number":"1234567890","holder":"PT ITOPUP"}
#   ewallet: {"name":"DANA","number":"081234567890","holder":"PT ITOPUP"}
#
# NEVER commit real account numbers. Configure them in the deployment
# environment, not in this file.
MANUAL_BANK_ACCOUNTS=
MANUAL_EWALLET_NUMBERS=
# How long the customer has to complete the transfer, in minutes.
MANUAL_TRANSFER_WINDOW_MINUTES=180

# ── Rate limiting ───────────────────────────────────────────────────────────
# Empty = in-process limiter (single instance only). Set both to use an
# external store (Upstash-compatible REST) when running more than one instance.
RATE_LIMIT_URL=
RATE_LIMIT_TOKEN=

# ── Rate limit tuning (requests per 60s window) ─────────────────────────────
RL_LOGIN=8
RL_LOGIN_IP=40
RL_REGISTER=5
RL_VALIDATE=20
RL_VALIDATE_IP=120
RL_ORDER=10
RL_WEBHOOK=300
RL_ADMIN=120
RL_OTP=10
RL_DEFAULT=60

# ── Email (SMTP) for registration OTP ────────────────────────────────────────
# Nodemailer transport. Registration sends a 6-digit code to verify the email
# address; without these, POST /api/auth/register answers 503
# ITP_OTP_MAIL_UNAVAILABLE instead of pretending to send.
#
# Any SMTP provider works (Zoho, Brevo, Mailtrap, Gmail App Password). Leave
# SMTP_PASS empty only for a truly open relay, which you do not have.
#
# Zoho Mail example:
#   SMTP_HOST=smtppro.zoho.com  SMTP_PORT=587  SMTP_USER=you@yourdomain.com
#   SMTP_PASS=<app-specific password>  SMTP_FROM="ITOPUP <noreply@yourdomain.com>"
#
# Brevo example:
#   SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<login email>
#   SMTP_PASS=<SMTP key>  SMTP_FROM="ITOPUP <noreply@yourdomain.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Google OAuth ("Masuk dengan Google") ─────────────────────────────────────
# From the Google Cloud Console: APIs & Services > Credentials > OAuth 2.0
# Client ID (Web application). While these are empty, the "Masuk dengan Google"
# button is hidden on /login and /register, and the start route answers 503.
#
# The Authorized redirect URI must be exactly:
#   <NEXT_PUBLIC_APP_URL>/api/auth/google/callback
#
# NOTE: the button only appears when the client id, secret AND redirect URI are
# all set. A half-configured Google login is worse than none.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# ============================================================================
# Test-only environment. Tests NEVER touch DATABASE_URL from .env — a
# misconfigured run must not be able to truncate the Supabase database.
# Copy to `.env.test` and point it at a local throwaway database.
# ============================================================================
DATABASE_URL="postgresql://localhost:5432/itopup_test"
DIRECT_URL="postgresql://localhost:5432/itopup_test"
AUTH_SECRET="test-only-secret-do-not-use-in-production-32chars+"
NEXT_PUBLIC_APP_URL="http://localhost:3200"
NODE_ENV="test"
SESSION_MAX_AGE=604800

TOPUP_PROVIDER=melostore
MELOSTORE_BASE_URL=
MELOSTORE_API_KEY=
MELOSTORE_SECRET=
MELOSTORE_WEBHOOK_SECRET=
MELOSTORE_SANDBOX=

PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_SECRET=
PAYMENT_WEBHOOK_SECRET=

RATE_LIMIT_URL=
RATE_LIMIT_TOKEN=
